{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "baseUrl": ".",
    "paths": {
      "@actions/*": ["src/actions/*"],
      "@middlewares/*": ["src/middlewares/*"],
      "@assets/*": ["src/assets/*"],
      "@notifications/*": ["src/notifications/*"],
